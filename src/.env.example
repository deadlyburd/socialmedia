# ═══════════════════════════════════════════════════════════════════════
# Social Automations — Agency Content Management Platform
# ═══════════════════════════════════════════════════════════════════════
# Copy this to .env.local and fill in all values marked REQUIRED.
# ═══════════════════════════════════════════════════════════════════════

# ── SUPABASE (ALL REQUIRED) ───────────────────────────────────────
# Supabase project URL (from Supabase dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── APP URL ───────────────────────────────────────────────────────
# Public URL of the app (used for CORS, redirects, OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI PROVIDER (blog automation) ──────────────────────────────────
# Choose one — DeepSeek or OpenAI-compatible API
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# ── FIRECRAWL (blog automation — competitor scraping) ────────────
# Get your key at https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── CRON ──────────────────────────────────────────────────────────
# Secret to protect cron endpoints (any random string)
CRON_SECRET=

# ── STRIPE (billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret from Stripe Dashboard > Webhooks (starts with whsec_)
# CRITICAL: set this in production to verify webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_...

# ── FILE STORAGE (pick one) ──────────────────────────────────────
# Option A: Vercel Blob (recommended — simplest setup)
# Get your token at https://vercel.com/dashboard/stores/blob
BLOB_READ_WRITE_TOKEN=

# Option B: Cloudflare R2 (alternative)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://cdn.yourdomain.com

# ── EMAIL (transactional — Resend) ───────────────────────────────
# Get your key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Social Automations <noreply@socialautomations.dev>"

# ── LOOMBA / SEEDANCE (AI video generation — optional) ──────────
# SEEDANCE_API_KEY=

# ── RATE LIMITING ────────────────────────────────────────────────
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SEC=900
